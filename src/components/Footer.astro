---
import { NAV, SERVICES, SITE, waLink } from '../data/site';
const year = new Date().getFullYear();
const socials = Object.entries(SITE.social).filter(([, url]) => url);
---

<footer class="relative border-t border-white/10 bg-ink-800">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-2 lg:grid-cols-4 lg:px-8">
    <div class="lg:col-span-1">
      <img src="/brand/logo-dark-bg.svg" alt="Soluweb" width="160" height="50" class="h-10 w-auto" loading="lazy" />
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-ink-300">
        IA, automatización y sistemas de gestión para negocios que quieren crecer sin sumar trabajo manual.
      </p>
    </div>
    <div>
      <h3 class="text-sm font-bold tracking-wider uppercase">Servicios</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {SERVICES.map((s) => <li><a href={`/#${s.id}`} class="text-ink-300 hover:text-white">{s.title}</a></li>)}
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-bold tracking-wider uppercase">Soluweb</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {NAV.map((n) => <li><a href={n.href} class="text-ink-300 hover:text-white">{n.label}</a></li>)}
        <li><a href="/marca" class="text-ink-300 hover:text-white">Manual de marca</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-bold tracking-wider uppercase">Contacto</h3>
      <ul class="mt-4 space-y-2.5 text-sm text-ink-300">
        <li><a href={waLink()} target="_blank" rel="noopener" class="hover:text-white">WhatsApp: {SITE.whatsappDisplay}</a></li>
        <li><a href={`mailto:${SITE.email}`} class="hover:text-white">{SITE.email}</a></li>
        <li>{SITE.location}</li>
        {socials.map(([name, url]) => <li><a href={url} target="_blank" rel="noopener" class="capitalize hover:text-white">{name}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-white/5">
    <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-5 py-6 text-xs text-ink-400 sm:flex-row lg:px-8">
      <p>© {year} Soluweb. Todos los derechos reservados.</p>
      <p>Hecho en Tucumán con IA y mate.</p>
    </div>
  </div>
</footer>

<a
  href={waLink()}
  target="_blank"
  rel="noopener"
  aria-label="Escribinos por WhatsApp"
  class="fixed right-5 bottom-5 z-40 grid size-14 place-items-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/40 transition hover:scale-105"
>
  <svg viewBox="0 0 24 24" class="size-7" fill="currentColor" aria-hidden="true">
    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35M12.05 21.5h-.01a9.4 9.4 0 0 1-4.8-1.32l-.34-.2-3.57.94.95-3.48-.22-.36a9.4 9.4 0 0 1-1.44-5.02c0-5.2 4.23-9.43 9.44-9.43 2.52 0 4.89.98 6.67 2.77a9.37 9.37 0 0 1 2.76 6.67c0 5.2-4.23 9.43-9.44 9.43m8.03-17.46A11.27 11.27 0 0 0 12.05.72C5.8.72.7 5.8.7 12.06c0 2 .52 3.95 1.52 5.67L.6 23.6l6.02-1.58a11.3 11.3 0 0 0 5.42 1.38h.01c6.25 0 11.34-5.09 11.35-11.35 0-3.03-1.18-5.88-3.32-8.02"></path>
  </svg>
</a>
