---
import { NAV, waLink } from '../data/site';
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between px-5 lg:px-8">
    <a href="/" class="shrink-0" aria-label="Soluweb, ir al inicio">
      <img src="/brand/logo-dark-bg.svg" alt="Soluweb" width="150" height="46" class="h-9 w-auto" />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {
        NAV.map((item) => (
          <a href={item.href} class="rounded-full px-4 py-2 text-sm font-medium text-ink-300 transition hover:bg-white/5 hover:text-white">
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href={waLink()} target="_blank" rel="noopener" class="btn-primary hidden !py-2.5 sm:inline-flex">
        Agendá un diagnóstico
      </a>
      <button
        id="menu-toggle"
        class="grid size-11 place-items-center rounded-full border border-white/10 bg-white/5 text-white lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h10"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-white/10 bg-ink/95 backdrop-blur-xl lg:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col px-5 py-4" aria-label="Móvil">
      {
        NAV.map((item) => (
          <a href={item.href} class="border-b border-white/5 py-3.5 font-display text-lg font-semibold text-white">
            {item.label}
          </a>
        ))
      }
      <a href={waLink()} target="_blank" rel="noopener" class="btn-primary mt-5">Agendá un diagnóstico gratis</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const onScroll = () => {
    const scrolled = window.scrollY > 12;
    header.classList.toggle('bg-ink/80', scrolled);
    header.classList.toggle('backdrop-blur-xl', scrolled);
    header.classList.toggle('border-b', scrolled);
    header.classList.toggle('border-white/10', scrolled);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  toggle.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));
</script>
