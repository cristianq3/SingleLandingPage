---
import { Image } from 'astro:assets';
import { img } from '../lib/images';
import { waLink } from '../data/site';
const hero = img('hero');
---

<section class="relative isolate overflow-hidden pt-28 pb-24 lg:pt-36 lg:pb-32">
  <div class="grid-bg absolute inset-0 -z-20 [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_75%)]"></div>
  <div class="absolute -top-40 left-1/2 -z-10 h-[600px] w-[900px] -translate-x-1/2 rounded-full bg-brand/25 blur-[140px]"></div>

  <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 lg:grid-cols-[1.02fr_1.08fr] lg:px-8">
    <div class="reveal">
      <div class="inline-flex flex-wrap items-center gap-2 rounded-full border border-brand/40 bg-brand/10 px-3.5 py-1.5 text-xs font-semibold text-white backdrop-blur">
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-spark opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-spark"></span>
        </span>
        Agentes IA para WhatsApp + Automatización + CRM & ERP
      </div>

      <h1 class="mt-6 text-4xl leading-[1.05] font-black sm:text-5xl lg:text-[4.1rem]">
        Tu negocio,<br />
        en <span class="skew-tag mx-1">piloto</span><br class="sm:hidden" /> automático.
      </h1>

      <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-300">
        Incorporamos <strong class="text-white">inteligencia artificial</strong>, automatizaciones, CRM y sistemas de gestión a medida para que tu
        empresa venda 24/7, atienda en segundos y deje de perder horas en planillas y tareas repetitivas.
      </p>

      <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href={waLink('Hola Soluweb! Quiero un diagnóstico gratis para automatizar mi negocio.')} target="_blank" rel="noopener" class="btn-primary !px-7 !py-4 !text-base">
          Diagnóstico gratis por WhatsApp
          <svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M11.3 3.3a1 1 0 0 1 1.4 0l6 6a1 1 0 0 1 0 1.4l-6 6a1 1 0 0 1-1.4-1.4L15.6 11H2a1 1 0 1 1 0-2h13.6l-4.3-4.3a1 1 0 0 1 0-1.4Z"></path></svg>
        </a>
        <a href="#resultados" class="btn-ghost !px-6 !py-4 !text-base">
          <span class="size-2 rounded-full bg-emerald-400"></span>
          Ver capturas reales
        </a>
      </div>

      <!-- Mini tira de confianza con avatares y valoración -->
      <div class="mt-9 flex flex-wrap items-center gap-4 rounded-2xl border border-white/10 bg-white/[0.03] p-3.5 backdrop-blur sm:inline-flex">
        <div class="flex -space-x-2.5">
          <span class="grid size-9 place-items-center rounded-full border-2 border-ink bg-brand text-xs font-extrabold text-white">MG</span>
          <span class="grid size-9 place-items-center rounded-full border-2 border-ink bg-emerald-600 text-xs font-extrabold text-white">CS</span>
          <span class="grid size-9 place-items-center rounded-full border-2 border-ink bg-indigo-600 text-xs font-extrabold text-white">LP</span>
          <span class="grid size-9 place-items-center rounded-full border-2 border-ink bg-amber-500 text-xs font-extrabold text-ink">+40</span>
        </div>
        <div class="text-xs">
          <div class="flex items-center gap-1 font-bold text-spark">
            <span>★★★★★</span>
            <span class="text-white">Empresas automatizadas en Argentina</span>
          </div>
          <p class="text-ink-300">Respuesta en 2 seg · +64% conversión en WhatsApp</p>
        </div>
      </div>

      <dl class="mt-10 grid max-w-lg grid-cols-3 gap-6 border-t border-white/10 pt-7">
        <div><dt class="text-xs text-ink-400">Atención IA</dt><dd class="font-display text-2xl font-extrabold text-white">24/7</dd></div>
        <div><dt class="text-xs text-ink-400">Ahorro medio</dt><dd class="font-display text-2xl font-extrabold text-spark">-20h/sem</dd></div>
        <div><dt class="text-xs text-ink-400">Diagnóstico</dt><dd class="font-display text-2xl font-extrabold text-white">Sin costo</dd></div>
      </dl>
    </div>

    <div class="reveal relative lg:pl-4">
      <div class="absolute inset-4 -z-10 -skew-x-12 rounded-[2.2rem] bg-brand/35 blur-3xl"></div>

      <!-- Marco principal con imagen del ecosistema en vivo -->
      <div class="group relative overflow-hidden rounded-[2rem] border border-white/15 bg-ink-800 shadow-[0_25px_70px_-15px_rgba(15,51,255,0.45)]">
        {
          hero ? (
            <Image
              src={hero}
              alt="Ecosistema Soluweb en vivo: WhatsApp IA respondiendo en 2 segundos, CRM comercial, ERP con facturación ARCA y mensajes de clientes"
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 52vw, 100vw"
              loading="eager"
              fetchpriority="high"
              class="w-full transition duration-700 group-hover:scale-[1.02]"
            />
          ) : (
            <div class="aspect-video w-full bg-ink-700" />
          )
        }
      </div>

      <!-- Tarjeta Flotante 1 (Arriba Derecha): Audio de WhatsApp procesado en vivo -->
      <div class="absolute -top-6 right-3 z-20 hidden animate-float items-center gap-3 rounded-2xl border border-emerald-400/35 bg-[#0F1922]/95 px-4 py-3 shadow-2xl backdrop-blur-md sm:flex">
        <span class="relative grid size-9 place-items-center rounded-full bg-emerald-500/20 text-emerald-400">
          <span class="absolute inset-0 animate-ping rounded-full bg-emerald-400/30"></span>
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M12 14a3 3 0 0 0 3-3V5a3 3 0 0 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-2Z"/></svg>
        </span>
        <div>
          <div class="flex items-center gap-2">
            <p class="text-[11px] font-bold tracking-wider text-emerald-400 uppercase">WhatsApp IA · En vivo</p>
            <span class="flex items-center gap-0.5 h-3">
              <span class="wave-bar h-3 w-0.5 rounded-full bg-emerald-400" style="animation-delay:0s"></span>
              <span class="wave-bar h-3 w-0.5 rounded-full bg-emerald-400" style="animation-delay:0.2s"></span>
              <span class="wave-bar h-3 w-0.5 rounded-full bg-emerald-400" style="animation-delay:0.4s"></span>
              <span class="wave-bar h-3 w-0.5 rounded-full bg-emerald-400" style="animation-delay:0.1s"></span>
            </span>
          </div>
          <p class="text-xs font-semibold text-white">Audio de 0:34 respondido y agendado</p>
        </div>
      </div>

      <!-- Tarjeta Flotante 2 (Abajo Izquierda): Captura flotante de mensaje de cliente -->
      <div class=" (animate-float-reverse) absolute -bottom-8 -left-4 z-20 hidden max-w-xs animate-float-reverse rounded-2xl border border-brand/50 bg-[#101826]/95 p-3.5 shadow-[0_20px_50px_rgba(0,0,0,0.8)] backdrop-blur-md sm:block">
        <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-2">
          <div class="flex items-center gap-2">
            <span class="grid size-7 place-items-center rounded-full bg-brand text-[11px] font-black text-white">LP</span>
            <div>
              <p class="text-xs font-bold text-white">Lucas Paz · Clínica San Martín</p>
              <p class="text-[10px] text-emerald-400">WhatsApp · recién</p>
            </div>
          </div>
          <span class="rounded-full bg-spark/15 px-2 py-0.5 text-[10px] font-bold text-spark">CLIENTE</span>
        </div>
        <p class="mt-2 text-xs leading-snug text-ink-200">
          “Cristian! El asistente confirmó <strong class="text-white">14 turnos el domingo</strong> sin que toquemos el teléfono 🙌🔥”
        </p>
        <div class="mt-1.5 flex items-center justify-end gap-1 text-[10px] text-sky-400">
          <span class="text-ink-400">21:18</span>
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M1.5 12.5l4 4 8.5-8.5M9 12.5l4 4 8.5-8.5"/></svg>
        </div>
      </div>
    </div>
  </div>
</section>
